nextflow.enable.moduleBinaries = true

params {
    help=false

    fs_input=false
    fs_output=false
    fs_license=false

    output_dir="results_fs"
}

process {
    tag = {"$meta.id"}
    publishDir = [path: {"${params.output_dir}/$meta.id/${task.process.split(':')[-1]}"}, mode: 'symlink']
    scratch = true
    stageInMode = 'copy'
    stageOutMode = 'rsync'
    cache = 'lenient'
    maxRetries = 1
    maxErrors = -1
}

includeConfig "modules/local/FS_BN_GL_SF_atlases/nextflow.config"
includeConfig "modules/local/lobe_atlas/nextflow.config"
includeConfig "modules/local/lausanne_atlas/nextflow.config"
includeConfig "modules/local/fastsurfer/nextflow.config"

profiles {
    use_gpu {
        apptainer.runOptions = '--nv'
        singularity.runOptions = '--nv'
        docker.runOptions = '-v /var/run/docker.sock:/var/run/docker.sock --entrypoint "" --gpus all --rm --user $(id -u):$(id -g) --network host'
    }
    slurm {
        process {
            executor = 'slurm'
            errorStrategy = 'retry'
            maxRetries = 1
            maxForks = 500
        }
        executor {
            pollInterval = '180 sec'
            queueGlobalStatus = true
            queueStatInterval = '3 min'
            submitRateLimit = '100/1min'
            queueSize = 500
        }
    }
    docker {
        docker.runOptions = "-v /var/run/docker.sock:/var/run/docker.sock --entrypoint "" --gpus all --rm --user $(id -u):$(id -g) --network host"
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    singularity {
        singularity.enabled       = true
        singularity.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        apptainer.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
}

manifest {
    name = 'Freesurfer Flow'
    description = 'Compute Freesurfer and other atlases'
    version = '0.1-edge'
    homePage = 'https://github.com/Onset-lab/freesurfer_flow'
}